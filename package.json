  "scripts": { "test": "node --test test/*.test.js" },
  "keywords": ["pubmed", "pmid", "citation", "reference", "hallucination", "llm", "fact-checking", "ncbi", "e-utilities"],
  "homepage": "https://github.com/klow-peptide/pubmed-citation-verifier",
  "repository": { "type": "git", "url": "https://github.com/klow-peptide/pubmed-citation-verifier.git" },
